{
  "name": "lightningcss-build",
  "version": "0.0.0-semantic-release",
  "description": "Opinionated CSS build tool for libraries, powered by lightningcss",
  "repository": "github:igordanchenko/lightningcss-build",
  "homepage": "https://github.com/igordanchenko/lightningcss-build",
  "bugs": "https://github.com/igordanchenko/lightningcss-build/issues",
  "funding": "https://github.com/sponsors/igordanchenko",
  "author": "Igor Danchenko",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lightningcss-build": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "ci": "npm run lint && npm run test"
  },
  "dependencies": {
    "browserslist": "^4.28.6",
    "chokidar": "^5.0.0",
    "lightningcss": "^1.32.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "commitlint-pre-push": "1.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "vitest": "5.0.5"
  },
  "keywords": [
    "css",
    "build",
    "lightningcss",
    "lightning-css",
    "bundler",
    "minifier",
    "browserslist",
    "watcher",
    "cli"
  ]
}
